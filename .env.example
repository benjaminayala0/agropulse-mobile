# ==============================================================================
# AgroPulse Mobile & Infra — Variables de Entorno de Ejemplo
# ==============================================================================

# Supabase Client (usado por la app móvil React Native / Expo)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Supabase Service Role (usado EXCLUSIVAMENTE por el worker backend / simulador IoT, NUNCA en la app móvil)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# Redpanda / Kafka Broker (usado por el worker backend en Docker)
KAFKA_BROKER=localhost:9092

# Credenciales de Usuarios de Prueba (Seed Didáctico Concordia)
# Productor (dueño/encargado: edita umbrales, emite comandos):
SEED_PRODUCER_EMAIL=productor@agropulse.test
SEED_PRODUCER_PASSWORD=AgroPulse2026!

# Operador (válvulas y comandos):
SEED_OPERATOR_EMAIL=operador@agropulse.test
SEED_OPERATOR_PASSWORD=AgroPulse2026!

# Asesor (agrónomo invitado: solo lectura de mapas e historial):
SEED_ADVISOR_EMAIL=asesor@agropulse.test
SEED_ADVISOR_PASSWORD=AgroPulse2026!
